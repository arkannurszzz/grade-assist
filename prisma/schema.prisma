generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GradingSession {
  id          String   @id @default(cuid())
  name        String
  courseName  String?
  description String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  answerKey       AnswerKey?
  submissions     Submission[]
  settings        SessionSettings?
  exportTemplates ExportTemplate[]
}

model AnswerKey {
  id                    String    @id @default(cuid())
  sessionId             String    @unique
  fileName              String
  fileType              String
  rawText               String
  parsedAt              DateTime?
  createdAt             DateTime  @default(now())
  aiDetectionConfidence Float?
  aiDetectionWarning    String?

  session   GradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Question {
  id             String   @id @default(cuid())
  answerKeyId    String
  questionNumber Int
  questionText   String
  correctAnswer  String
  weight         Float    @default(1.0)
  createdAt      DateTime @default(now())

  answerKey      AnswerKey      @relation(fields: [answerKeyId], references: [id], onDelete: Cascade)
  studentAnswers StudentAnswer[]
}

model Submission {
  id           String    @id @default(cuid())
  sessionId    String
  studentName  String
  fileName     String
  fileType     String
  rawText      String
  status       String    @default("uploaded")
  errorMessage String?
  totalScore   Float?
  maxScore     Float?
  percentage   Float?
  gradedAt     DateTime?
  createdAt    DateTime  @default(now())

  session GradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers StudentAnswer[]
}

model StudentAnswer {
  id            String   @id @default(cuid())
  submissionId  String
  questionId    String
  answerText    String
  score         Float?
  weightedScore Float?
  feedback      String?
  createdAt     DateTime @default(now())

  submission  Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  aiDetection AIDetection?
}

model AIDetection {
  id              String   @id @default(cuid())
  studentAnswerId String   @unique
  isAIGenerated   Boolean  @default(false)
  confidence      Float    @default(0.0)
  isCopyPasted    Boolean  @default(false)
  similarityScore Float    @default(0.0)
  suspectedParts  Json?
  analysis        String?
  penaltyApplied  Float    @default(0.0)
  createdAt       DateTime @default(now())

  studentAnswer StudentAnswer @relation(fields: [studentAnswerId], references: [id], onDelete: Cascade)
}

model SessionSettings {
  id                   String  @id @default(cuid())
  sessionId            String  @unique
  aiProvider           String  @default("gemini")
  modelName            String  @default("gemma-3n-e4b-it")
  gradingStrictness    String  @default("moderate")
  enableAIDetection    Boolean @default(true)
  aiPenaltyPercent     Float   @default(50.0)
  copyPenaltyPercent   Float   @default(30.0)
  aiDetectionThreshold Float   @default(0.7)
  language             String  @default("id")
  gradingScale         Json?

  session GradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AppSettings {
  id              String   @id @default("default")
  geminiApiKey    String   @default("")
  openaiApiKey    String   @default("")
  defaultProvider String   @default("gemini")
  updatedAt       DateTime @updatedAt
}

model ExportTemplate {
  id        String   @id @default(cuid())
  sessionId String?  // null = global template
  name      String
  isDefault Boolean  @default(false)
  columns   Json     // Column configuration
  createdAt DateTime @default(now())

  session GradingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
